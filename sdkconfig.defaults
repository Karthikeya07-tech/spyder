# ESP32-P4: USB 1.1 host on GPIO27 (D+) / GPIO26 (D-).
# Console stays on UART0. USB Serial/JTAG must stay off — it shares those pins.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# This board is ESP32-P4 rev v1.3. Rev 3.x binaries will not flash/boot on it.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Chip is 16 MB; the 2 MB header was a mismatch. Large app holds USB host + Wi-Fi.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_HTTPD_WS_SUPPORT=y

# P4 Wi-Fi is the onboard ESP32-C6 via ESP-Hosted / Wi-Fi Remote.
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# ESP-Hosted's SDIO mempool needs DMA RAM. Without PSRAM it panics at boot:
# "mempool create failed: no mem" / sdio_mempool_create.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
